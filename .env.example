# Required by src.config.load_settings. The process exits if either value is missing.
OPENAI_API_KEY=your-key-here
PINECONE_API_KEY=your-key-here

# Required for Langfuse traces and for `python -m src.check_credentials`.
# load_settings() does not read these. The Langfuse SDK reads them from the environment
# after python-dotenv loads this file.
# LANGFUSE_BASE_URL is the current name. LANGFUSE_HOST is the older name, kept alongside it.
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional. src.config.Settings uses these defaults when the variables are absent.
PINECONE_INDEX=multi-agent-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
